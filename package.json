{
  "name": "my-struggle-minigames",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build:client && node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build:client": "esbuild client/main.ts --bundle --format=esm --splitting --minify --outdir=dist/public --chunk-names=chunks/[name]-[hash] && node scripts/copy-public.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && npm run build:client",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "npm run build && npm run test:unit && playwright test"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.4",
    "express": "^5.1.0",
    "phaser": "3.90.0",
    "planck": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
